# Copy to .env and fill in (never commit .env — it's gitignored).
# uv does not load this file automatically; run commands with:
#   uv run --env-file .env <command>
# Everything below is optional; defaults serve the mock platform backend.

# Which system backs the task tools: platform (default) or clickup
OPS_TASK_BACKEND=platform

# Platform API location (default http://127.0.0.1:8000)
#OPS_PLATFORM_URL=http://127.0.0.1:8000

# Required when OPS_TASK_BACKEND=clickup: personal token from ClickUp → Settings → Apps
#CLICKUP_API_TOKEN=pk_xxxxxxx

# Required when the token can access multiple workspaces. The adapter fails closed
# rather than guessing which workspace to use.
#CLICKUP_TEAM_ID=

# ClickUp writes are disabled by default. Reads remain available. Change this to true
# only after confirming the workspace and intended change.
CLICKUP_WRITES_ENABLED=false
